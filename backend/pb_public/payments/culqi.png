</div></div></div></div></section><section id="integra-card" class="brxe-section"><img loading="lazy" width="1059" height="717" src="https://integrapagos.com/wp-content/uploads/element-azul.png" class="brxe-image css-filter size-full" alt id="brxe-jgzzrz" decoding="async" srcset="https://integrapagos.com/wp-content/uploads/element-azul.png 1059w, https://integrapagos.com/wp-content/uploads/element-azul-768x520.png 768w" sizes="(max-width: 1059px) 100vw, 1059px" /><div id="brxe-rhmyty" class="brxe-container"><div id="brxe-idpqoz" class="brxe-div"><svg class="brxe-icon" id="brxe-kpeonn" xmlns="http://www.w3.org/2000/svg" width="265" height="50" viewBox="0 0 265 50" fill="none"><g clip-path="url(#clip0_4001_899)"><path d="M58.5864 7.40936H63.1373V36.6433H58.5864V7.40936Z" fill="white"></path><path d="M68.4602 14.4094H72.239V18.7076C73.5393 15.3918 76.0585 13.7544 79.8373 13.7544C85.851 13.7544 88.0045 17.4386 88.0045 23.3333V36.6374H83.6162V23.1696C83.6162 19.4445 81.9096 17.6023 78.5371 17.6023C74.7583 17.6023 72.8892 19.8538 72.8892 24.3567V36.6374H68.4602V14.4094Z" fill="white"></path><path d="M101.007 36.6433C96.7404 36.6433 94.3025 34.7193 94.3025 29.6023V18.386H89.5891V14.4152H94.4244L95.7246 8.4386H98.6908V14.4152H107.346V18.386H98.6908V29.193C98.6908 31.7719 99.666 32.7134 101.616 32.7134H107.793V36.6433H101.007Z" fill="white"></path><path d="M111.003 34.1462C109.012 32.0175 108.036 29.193 108.036 25.6725C108.036 22.152 109.012 19.1637 110.962 16.9942C112.953 14.8246 115.594 13.7193 118.885 13.7193C121.933 13.7193 124.33 14.7427 126.077 16.8304C127.865 18.8772 128.759 21.6199 128.759 25.0585C128.759 25.7953 128.718 26.4094 128.637 26.8597H112.628C112.79 30.9123 115.31 33.4912 119.21 33.4912C121.811 33.4912 124.046 32.1813 125.183 29.9298L128.84 31.6082C127.093 35.1696 123.436 37.2982 119.048 37.2982C115.675 37.2982 112.994 36.2339 111.003 34.1462ZM124.289 23.462C124.289 19.6959 122.177 17.4035 118.601 17.4035C115.228 17.4035 112.994 19.6959 112.628 23.462H124.2