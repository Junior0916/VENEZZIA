<style data-phast-original-src="https://integrapagos.com/wp-content/uploads/core-framework/css/core_framework.css?ver=1787589045" data-phast-params='{"ref":"K-JGcI4jOKI"}'>html{font-size:62.5%;}:root{--primary-celeste:#00a4ffff;--primary-azul:#0035d4ff;--primary-violeta:#880099ff;--primary-rojo:#EE0000FF;--primary-naranja:#F60;--primary-amarillo:#FFD400;--primary-verde:#00CC00FF;--secondary-33:hsla(0,0%,20%,1);--secondary-99:#999999FF;--neutral-f1:#F1F1F1FF;--neutral-ff:#FFFFFFFF;--txt-body-small:clamp(1.4rem,calc(0vw + 1.4rem),1.4rem);--txt-body:clamp(1.6rem,calc(0vw + 1.6rem),1.6rem);--txt-body-big:clamp(2rem,calc(0vw + 2rem),2rem);--txt-title-6:clamp(2.4rem,calc(0vw + 2.4rem),2.4rem);--txt-title-3:clamp(3.6rem,calc(0vw + 3.6rem),3.6rem);--txt-title-1:clamp(6rem,calc(0vw + 6rem),6rem);--radius-xs:clamp(0.4rem,calc(0vw + 0.4rem),0.4rem);--radius-s:clamp(0.6rem,calc(0.19vw + 0.54rem),0.8rem);--radius-m:clamp(1rem,calc(0.19vw + 0.94rem),1.2rem);--radius-l:clamp(1.6rem,calc(0.37vw + 1.48rem),2rem);--radius-xl:clamp(2.6rem,calc(0.56vw + 2.42rem),3.2rem);--radius-full:999rem;--shadow-xs:0 1px 2px var(--shadow-primary);--shadow-s:0 1.5px 3px var(--shadow-primary);--shadow-m:0 2px 6px var(--shadow-primary);--shadow-l:0 3px 12px var(--shadow-primary);--shadow-xl:0 6px 48px var(--shadow-primary);}.text-primary-violeta{color:var(--primary-violeta);}.bg-secondary-33{background-color:var(--secondary-33);}.text-secondary-33{color:var(--secondary-33);}.text-secondary-99{color:var(--secondary-99);}.bg-neutral-f1{background-color:var(--neutral-f1);}.bg-neutral-ff{background-color:var(--neutral-ff);}.text-neutral-ff{color:var(--neutral-ff);}.txt-title-1{font-size:var(--txt-title-1);font-weight:600;line-height:60px;}.txt-title-3{font-size:var(--txt-title-3);font-weight:500;line-height:normal;}.txt-title-6{font-size:var(--txt-title-6);font-weight:600;line-height:normal;}.txt-body{font-size:var(--txt-body);font-weight:400;line-height:normal;}.txt-body-semi-bold{font-size:var(--txt-bod