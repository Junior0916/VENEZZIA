6 26.9006 35.4665 24.4913L39.5181 24.1989C39.8258 28.4913 36.8364 34.0234 31.8966 38.2866C26.8465 42.6491 20.7342 44.9591 14.5291 44.9591L14.5349 44.9532Z" fill="white"></path><path d="M24.13 38.7836C22.4814 38.7836 20.7575 38.6199 19.0161 38.2866C10.5064 36.6491 3.57567 31.4211 0 23.9415L3.66274 22.1638C7.94077 31.1111 16.3633 33.6082 19.7823 34.2632C25.6218 35.386 30.1842 34.1345 31.9488 32.4912L34.706 35.5029C32.419 37.6257 28.5415 38.7836 24.1358 38.7836H24.13Z" fill="white"></path><path d="M22.9167 38.7602C18.6967 38.1053 14.0065 33.9357 10.9823 28.1403C6.94807 20.4152 6.68105 11.6959 10.2567 4.21637L13.9195 5.99415C9.64143 14.9415 12.9559 23.1287 14.5754 26.2339C17.3442 31.5322 21.1637 34.345 23.532 34.7134L22.9167 38.7602Z" fill="white"></path><path d="M13.0372 31.5088C10.9127 27.7778 11.2262 21.4854 13.8325 15.4854C17.3153 7.49123 23.9152 1.84795 31.9546 0L32.8601 3.9883C23.2476 6.19883 18.958 13.9123 17.5649 17.1287C15.1792 22.614 15.3765 27.3743 16.5723 29.4737L13.0488 31.5088H13.0372Z" fill="white"></path><path d="M16.2879 20.7193L12.509 19.2105C14.0821 15.2105 19.1554 11.5322 25.4418 9.84796C33.8121 7.60235 42.3101 9.28071 48.7533 14.462L46.2225 17.6608C38.5139 11.4678 29.8533 12.9006 26.4866 13.8012C20.74 15.345 17.1702 18.4678 16.2879 20.7135V20.7193Z" fill="white"></path><path d="M48.0103 36.7135H43.947C43.947 26.7837 37.4342 20.8538 34.6364 18.7661C29.8591 15.1989 25.2096 14.3392 22.911 15.041L21.7268 11.1228C25.8133 9.86553 31.8269 11.5731 37.0569 15.4737C44.0225 20.6667 48.0161 28.4094 48.0161 36.7135H48.0103Z" fill="white"></path><path d="M30.2772 50L27.7463 46.8012C35.4549 40.6082 35.9948 31.7836 35.8729 28.2749C35.6581 22.2866 33.4291 18.0877 31.4497 16.7193L33.7484 13.345C37.2718 15.7778 39.6981 21.5848 39.9303 28.1287C40.2438 36.8538 36.7203 44.8246 30.2772 50Z" fill="white"></path></g><defs><clipPath id="clip0_4001_899"><rect width="265" height="50" fill="white"></rect></clipPath></defs></svg><h3 id="brxe-hhbizr" class="brxe-heading txt-title-3 text-neutral-ff font-primary">Tu Tarjeta, Tu Libertad</h3><div id="brxe-inywfz" class="brxe-text text-neutral-ff font-primary txt-body-big"><p>Integra Card es la tarjeta de débito que acompaña a Integra Pagos, ofreciéndote acceso rápido y seguro a tus fondos. Con ella, puedes realizar pagos, retiros y administrar tu dinero con total tranquilidad, sabiendo que formas parte de una red que te apoya en cada paso.</p>
</div></div><div id="brxe-hcqpme" class="brxe-div"><img loading="lazy" width="650" height="565" src="https://integrapagos.com/wp-content/uploads/Phone-card.png" class="brxe-image css-filter size-full" alt id="brxe-hgptec" data-interactions='[{"id":"gwcosm","trigger":"enterView","action":"startAnimation","animationType":"fadeInRight","target":"self","runOnce":"1"}]' data-interaction-id="41ed47" data-interaction-hidden-on-load="1" decoding="async" /></div></div></section><section id="soluciones" class="brxe-section"><div id="brxe-tdidbt" class="brxe-container"><h3 id="brxe-sulgwk" class="brxe-heading font-primary text-secondary-33 txt-title-3 text-center">Todo lo que Necesitas para<br>Hacer Crecer tu Negocio</h3><div id="brxe-zfayna" class="brxe-text font-primary txt-body text-secondary-99 text-center"><p>Integra Pagos te ofrece un conjunto completo de soluciones para facilitar tu día a día como emprendedor o pequeño comerciante:</p>
</div><div id="brxe-uvljqj" class="brxe-div"><div id="brxe-teykuc" class="brxe-div" data-interactions="[{&quot;id&quot;:&quot;pkcvfz&quot;,&quot;trigger&quot;:&quot;enterView&quot;,&quot;action&quot;:&quot;startAnimation&quot;,&quot;animationType&quot;:&quot;fadeInUp&quot;,&quot;runOnce&quot;:&quot;1&quot;}]" data-interaction-id="3f53f4" data-interaction-hidden-on-load="1"><h3 id="brxe-rjudem" class="brxe-heading font-primary text-neutral-ff txt-title-6">Terminales<br>de Pago</h3><div id="brxe-gzujqb" class="brxe-text font-primary text-neutral-ff txt-body"><p>Acepta pagos con tarjetas de crédito, débito y prepagas de manera fácil y segura.</p>
</div></div><div id="brxe-bgflrx" class="brxe-div" data-interactions="[{&quot;id&quot;:&quot;bewntq&quot;,&quot;trigger&quot;:&quot;enterView&quot;,&quot;action&quot;:&quot;startAnimation&quot;,&quot;animationType&quot;:&quot;fadeInUp&quot;,&quot;runOnce&quot;:&quot;1&quot;,&quot;animationDelay&quot;:&quot;.2s&quot;}]" data-interaction-id="29a900" data-interaction-hidden-on-load="1"><h3 id="brxe-cgxsnp" class="brxe-heading font-primary text-neutral-ff txt-title-6">Cuotas<br>sin Interés</h3><div id="brxe-cjyaxc" class="brxe-text font-primary text-neutral-ff txt-body"><p>Ofrece a tus clientes la posibilidad de pagar en cuotas, sin preocuparte por los intereses.</p>
</div></div><div id="brxe-fsjbxy" class="brxe-div" data-interactions="[{&quot;id&quot;:&quot;itxczt&quot;,&quot;trigger&quot;:&quot;enterView&quot;,&quot;action&quot;:&quot;startAnimation&quot;,&quot;animationType&quot;:&quot;fadeInUp&quot;,&quot;runOnce&quot;:&quot;1&quot;,&quot;animationDelay&quot;:&quot;.4s&quot;}]" data-interaction-id="e361e7" data-interaction-hidden-on-load="1"><h3 id="brxe-bkgxum" class="brxe-heading font-primary text-neutral-ff txt-title-6">Cuota Simple</h3><div id="brxe-kmcdxe" class="brxe-text font-primary text-neutral-ff txt-body"><p>Una solución para que tus clientes puedan financiar sus compras en cuotas, permitiéndoles mayor flexibilidad al momento de pagar.</p>
</div></div><div id="brxe-cvirok" class="brxe-div" data-interactions="[{&quot;id&quot;:&quot;vpexmk&quot;,&quot;trigger&quot;:&quot;enterView&quot;,&quot;action&quot;:&quot;startAnimation&quot;,&quot;animationType&quot;:&quot;fadeInUp&quot;,&quot;runOnce&quot;:&quot;1&quot;,&quot;animationDelay&quot;:&quot;.6s&quot;}]" data-interaction-id="800ae5" data-interaction-hidden-on-load="1"><h3 id="brxe-fmytwn" class="brxe-heading font-primary text-neutral-ff txt-title-6">Gestión y<br>Administración</h3><div id="brxe-dbkrfu" class="brxe-text font-primary text-neutral-ff txt-body"><p>Herramientas integradas para que puedas llevar un control eficiente de tus finanzas y administración.</p>
</div></div></div></div></section><section id="como-funciona" class="brxe-section"><img loading="lazy" width="645" height="784" src="https://integrapagos.com/wp-content/uploads/element-gris.png" class="brxe-image css-filter size-full" alt id="brxe-fzrpmr" decoding="async" /><div id="brxe-xbmfdw" class="brxe-container"><h3 id="brxe-shahcd" class="brxe-heading font-primary txt-title-3 text-neutral-ff">Fácil, Rápido y Seguro</h3><div id="brxe-wlopdh" class="brxe-div brx-grid"><div id="brxe-thmytm" class="brxe-div" data-interactions="[{&quot;id&quot;:&quot;icfbkw&quot;,&quot;trigger&quot;:&quot;enterView&quot;,&quot;action&quot;:&quot;startAnimation&quot;,&quot;animationType&quot;:&quot;fadeInUp&quot;,&quot;runOnce&quot;:&quot;1&quot;}]" data-interaction-id="efcdf3" data-interaction-hidden-on-load="1"><svg class="brxe-icon" id="brxe-yzrknv" xmlns="http://www.w3.org/2000/svg" width="182" height="182" viewBox="0 0 182 182" fill="none"><path d="M90.9999 182C141.208 182 181.909 141.299 181.909 91.0912C181.909 40.8835 141.208 0.182129 90.9999 0.182129C40.7922 0.182129 0.0908203 40.8835 0.0908203 91.0912C0.0908203 141.299 40.7922 182 90.9999 182Z" fill="#880099"></path><path d="M135.221 94.6078C135.302 93.5563 136.191 92.7737 137.242 92.8552C138.294 92.9367 139.077 93.8497 138.995 94.8768C138.025 107.414 132.278 118.606 123.572 126.644C114.94 134.624 103.405 139.507 90.7293 139.507C77.3851 139.507 65.2718 134.086 56.5088 125.323C47.7458 116.552 42.325 104.471 42.325 91.0945C42.325 77.7177 47.7458 65.6207 56.5088 56.8495C65.2718 48.0865 77.3769 42.6738 90.7293 42.6738C94.585 42.6738 98.3837 43.1303 102.027 44.0188C105.777 44.9074 109.331 46.2279 112.649 47.9316C113.595 48.3881 113.97 49.5538 113.489 50.4668C113 51.4124 111.866 51.7873 110.929 51.3064C107.856 49.7413 104.563 48.5267 101.139 47.6952C97.8212 46.9127 94.3405 46.4806 90.7293 46.4806C78.404 46.4806 67.2689 51.4939 59.1825 59.5558C51.1124 67.6096 46.1236 78.7774 46.1236 91.0945C46.1236 103.412 51.1124 114.555 59.1744